@startuml
!include style.puml

title PWasm Persistence Backend: Current Class Structure
caption External research note; Wizard Engine commit 4f4657749480ba58628f65837ca25184d1fd91d7 (2026-06-08).

package "Portable API" {
  class BackendRegion {
    +range: Range<byte>
    +destroy()
    +prepareChangedRange(offset: u64, size: u64): bool
    +persistChanges(): bool
    +persistRange(offset: u64, size: u64): bool
  }

  class TxnRegionBackend {
    +create(size: u64, prot: int): BackendRegion
    +isPersistent(): bool
    +name(): string
  }
}

package "x86-64 mmap implementation" {
  class FdMmapRegion {
    +mapping: Mapping
    +fd: int
    +validRange(offset: u64, size: u64): bool
    +cleanupBeforeDestroy()
    +closeFd()
  }

  class FileMmapRegion {
    +hasDirtyChanges: bool
  }

  class PmemMmapRegion {
    +hasPendingWriteback: bool
  }

  class PmemMmapBackend {
    +path: string
    +makePersistentRegion(mapping: Mapping, fd: int): PmemMmapRegion
  }

  class FileMmapBackend {
    +path: string
    +makeFileRegion(mapping: Mapping, fd: int): FileMmapRegion
  }
}

TxnRegionBackend <|-- PmemMmapBackend
TxnRegionBackend <|-- FileMmapBackend

BackendRegion <|-- FdMmapRegion
FdMmapRegion <|-- FileMmapRegion
FdMmapRegion <|-- PmemMmapRegion

PmemMmapBackend ..> PmemMmapRegion : creates
FileMmapBackend ..> FileMmapRegion : creates

note right of TxnRegionBackend
Current shape:
backends create regions and report capabilities,
but regions do not retain backend references;
region objects own lifecycle and persistence behavior.
end note

note bottom of PmemMmapRegion
PMEM path:
prepareChangedRange flushes cache lines;
persistChanges issues the fence;
persistRange flushes and fences immediately.
end note

note bottom of FileMmapRegion
File mmap path:
prepareChangedRange records dirty state;
persistChanges calls fdatasync;
persistRange calls msync.
end note

@enduml
